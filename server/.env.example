PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mailer
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5000/api
SUPERADMIN_EMAIL=admin@company.com
SUPERADMIN_PASSWORD=ChangeMe123!

# --- Gmail (free) ---
# Google Account > Security > turn on 2-Step Verification > App passwords > create one
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="Your Company <yourname@gmail.com>"

# Free Gmail ~500/day, Google Workspace ~2000/day. Keep a safety margin.
DAILY_LIMIT=400
# Send BATCH mails every INTERVAL_MS (5 mails / 20s is a gentle pace)
BATCH=5
INTERVAL_MS=20000
